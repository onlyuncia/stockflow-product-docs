<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_10-bpmn-to-be" targetNamespace="https://stockflow.example/diagrams">
  <bpmn:process id="Process_10-bpmn-to-be" isExecutable="false">
    <bpmn:laneSet id="Lanes_10-bpmn-to-be">
      <bpmn:lane id="Manager" name="Менеджер селлера">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>View</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Service" name="StockFlow · автоматические действия">
        <bpmn:flowNodeRef>Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Рекомендация&#10;готова">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="View" name="Просмотреть потребность&#10;и состояние данных">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Continue" name="Продолжить?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Confirm" name="Заново подтвердить&#10;свой остаток">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="Allocate" name="Предложить распределение&#10;и объём закупки">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review" name="Проверить / изменить&#10;и выбрать решение">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Validate" name="Проверить новый снимок&#10;и лимит отгрузки">
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Проверки пройдены?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Save" name="Сохранить решение&#10;и отдельные планы">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Планы&#10;сохранены">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Reject" name="Сохранить отказ&#10;без планов">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Rejected" name="Отказ сохранён">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Choice" name="Утвердить?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="View" name="" />
    <bpmn:sequenceFlow id="F2" sourceRef="View" targetRef="Continue" name="" />
    <bpmn:sequenceFlow id="F3" sourceRef="Continue" targetRef="Confirm" name="да" />
    <bpmn:sequenceFlow id="F4" sourceRef="Continue" targetRef="Reject" name="нет: причина отказа" />
    <bpmn:sequenceFlow id="F5" sourceRef="Reject" targetRef="Rejected" name="" />
    <bpmn:sequenceFlow id="F6" sourceRef="Confirm" targetRef="Allocate" name="" />
    <bpmn:sequenceFlow id="F7" sourceRef="Allocate" targetRef="Review" name="" />
    <bpmn:sequenceFlow id="F10" sourceRef="Validate" targetRef="Valid" name="" />
    <bpmn:sequenceFlow id="F11" sourceRef="Valid" targetRef="Save" name="да" />
    <bpmn:sequenceFlow id="F12" sourceRef="Save" targetRef="End" name="" />
    <bpmn:sequenceFlow id="F13" sourceRef="Valid" targetRef="Confirm" name="нет: исправить данные / подтвердить заново" />
    <bpmn:sequenceFlow id="F8" sourceRef="Review" targetRef="Choice" name="" />
    <bpmn:sequenceFlow id="F9" sourceRef="Choice" targetRef="Validate" name="да" />
    <bpmn:sequenceFlow id="F14" sourceRef="Choice" targetRef="Reject" name="нет: причина отказа" />
  </bpmn:process>
  <bpmn:collaboration id="Collab_10-bpmn-to-be">
    <bpmn:participant id="Pool_10-bpmn-to-be" name="Подготовка подсорта" processRef="Process_10-bpmn-to-be" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_10-bpmn-to-be">
