@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
UpdateLegendTitle("Легенда")
UpdateElementStyle("container", $legendText="Контейнер StockFlow")
UpdateElementStyle("component", $legendText="Компонент сервера")
UpdateElementStyle("external_system", $legendText="Внешняя система")
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 120

title C4 · уровень 3 · Обновление данных и расчёт StockFlow

System_Ext(ozon, "Ozon", "Продажи и остатки кабинетов.")
System_Ext(wb, "Wildberries", "Продажи и остатки кабинетов.")
Container_Boundary(backend, "Серверное приложение StockFlow") {
 Component(sync, "Синхронизация и сопоставление", "Фоновый модуль", "Получает данные площадок, сопоставляет товары и фиксирует ошибки обновления.")
 Component(calc, "Расчёт потребности", "Модуль сервера", "По полным данным и версии правил сохраняет потребность до ограничения своим складом.")
 Component(data, "Доступ к снимкам и истории", "Модуль сервера", "Читает и сохраняет предметные данные и версии.")
}
ContainerDb(db, "База данных", "PostgreSQL", "Предметные данные и история.")

Rel_R(sync, ozon, "Запрашивает продажи и остатки", "API")
Rel_R(sync, wb, "Запрашивает продажи и остатки", "API")
Rel_D(sync, calc, "Передаёт полные сопоставленные данные")
Rel_D(calc, data, "Читает снимки и правила; сохраняет рекомендацию")
Rel(sync, data, "Сохраняет снимки, состояния и ошибки; читает сопоставления")
Rel_R(data, db, "Читает и сохраняет данные", "SQL")
Lay_D(ozon, wb)

SHOW_LEGEND($hideStereotype="false")
@enduml

