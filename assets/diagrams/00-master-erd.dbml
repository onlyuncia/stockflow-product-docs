// Основной источник реляционной модели StockFlow для PostgreSQL.
// 18 таблиц определены по одному разу; 30 связей объединяют две подробные схемы.
// Дополнительный частичный уникальный индекс описан в docs/07-DATA-MODEL.md.

Project StockFlowMaster {
  database_type: 'PostgreSQL'
  Note: '''
    Полная реляционная модель StockFlow.
    Заголовки документов и позиции нормализованы в отдельных таблицах.
    API собирает документ с вложенным списком lines.
    Этот DBML содержит полные поля и ограничения; SVG и PlantUML показывают обзор ключей.
    Частичный уникальный индекс для утверждённых решений дополняет SQL-экспорт
    согласно разделу ограничений в docs/07-DATA-MODEL.md.
  '''
}

// Селлер и товары

Table Seller {
  sellerId text [pk, not null]

  Note: 'Селлер. Организация, в границах которой учитываются кабинеты, товары и правила.'
}

Table MarketplaceAccount {
  accountId text [pk, not null]
  sellerId text [not null]
  marketplace text [not null, note: 'Площадка: Ozon или Wildberries.']
  externalAccountId text [not null, note: 'Идентификатор кабинета на площадке.']

  indexes {
    (sellerId, marketplace, externalAccountId) [unique]
  }

  Note: 'Кабинет площадки. У одного селлера может быть несколько кабинетов.'
}

Table Product {
  productId text [pk, not null]
  sellerId text [not null]
  internalSku text [not null, note: 'Артикул во внутреннем учёте селлера.']

  indexes {
    (sellerId, internalSku) [unique]
  }

  Note: 'Внутренний товар. Объединяет потребность площадок и собственный остаток по одному товару.'
}

Table Listing {
  listingId text [pk, not null]
  accountId text [not null]
  productId text [null, note: 'Отсутствует до сопоставления с внутренним товаром.']
  externalListingId text [not null, note: 'Идентификатор товара в конкретном кабинете площадки.']

  indexes {
    (accountId, externalListingId) [unique]
  }

  Note: 'Товар площадки. Несопоставленная строка не участвует в расчёте или плане другого SKU.'
}

// Входные данные

Table SyncRun {
  syncRunId text [pk, not null]
  accountId text [not null]
  dataType text [not null, note: 'Обновление продаж либо остатков.']
  startedAt timestamptz [not null]
  completedAt timestamptz [null]
  result text [not null, note: 'Состояние или результат обновления.']
  errorCode text [null]
  errorMessage text [null]

  Note: 'Обновление. Ошибка API не создаёт фиктивный снимок с нулевым количеством.'
}

Table SalesSnapshot {
  salesSnapshotId text [pk, not null]
  syncRunId text [not null]
  listingId text [not null]
  periodStart date [not null]
  periodEnd date [not null]
  salesUnits integer [not null, check: `"salesUnits" >= 0`, note: 'Проданные единицы за окно; 0 — подтверждённое отсутствие продаж.']

  checks {
    `"periodStart" <= "periodEnd"`
  }

  Note: 'Снимок продаж. Сохраняет данные успешного обновления за выбранный период.'
}

Table MarketplaceStockSnapshot {
  stockSnapshotId text [pk, not null]
  syncRunId text [not null]
  listingId text [not null]
  marketplaceStockUnits integer [not null, check: `"marketplaceStockUnits" >= 0`, note: 'Подтверждённый остаток площадки, неотрицательное количество.']
  observedAt timestamptz [not null, note: 'Время, к которому относится остаток.']

  Note: 'Снимок остатка площадки. Может относиться к другому обновлению, чем снимок продаж.'
}

Table OwnStockSnapshot {
  ownStockSnapshotId text [pk, not null]
  productId text [not null]
  availableUnits integer [not null, check: `"availableUnits" >= 0`, note: 'Подтверждённый доступный остаток; количество неотрицательное.']
  sourceKind text [not null, note: 'Учётная система или таблица селлера.']
  sourceLabel text [not null, note: 'Описание источника собственного остатка.']
  sourceObservedAt timestamptz [not null]
  confirmedAt timestamptz [not null]
  confirmedBy text [not null, note: 'Идентификатор подтвердившего менеджера.']

  Note: '''
    Снимок своего склада. Фиксированного срока действия нет.
    Может использоваться в нескольких неутверждённых предложениях.
    Снимок, использованный в утверждённом решении, нельзя использовать для следующего утверждения.
  '''
}

// Правила и рекомендация

Table RuleVersion {
  ruleVersionId text [pk, not null]
  sellerId text [not null]
  marketplace text [not null]
  category text [not null]
  version text [not null]
  targetCoverageDays integer [not null, check: `"targetCoverageDays" > 0`]
  roundingPolicy text [not null]

  Note: 'Версия правила. Сохранённые настройки покрытия и округления для селлера, площадки и категории.'
}

Table Recommendation {
  recommendationId text [pk, not null]
  productId text [not null]

  Note: 'Общие данные рекомендации по одному внутреннему товару. Потребность площадок хранится в RecommendationLine; в API возвращается вложенным списком lines.'
}

Table RecommendationLine {
  recommendationId text [not null]
  listingId text [not null]
  sourceSalesSnapshotId text [null, note: 'Ссылка отсутствует, если продажи не получены.']
  sourceStockSnapshotId text [null, note: 'Ссылка отсутствует, если остаток площадки не получен.']
  ruleVersionId text [null, note: 'Использованная версия правила; отсутствует, если правило не определено.']
  dataState text [not null]
  targetStockUnits integer [null, check: `"targetStockUnits" >= 0`]
  recommendedUnits integer [null, check: `"recommendedUnits" >= 0`]
  calculationIssue text [null]

  indexes {
    (recommendationId, listingId) [pk]
  }
  checks {
    `"dataState" IN ('ready', 'missing_sales', 'missing_stock', 'missing_both')`
  }

  Note: 'Позиция рекомендации. Ключ — рекомендация и товар площадки. Отсутствующие данные не заменяются нулём; обязательность снимков и правила при готовом расчёте проверяет сервер.'
}

// Распределение

Table AllocationProposal {
  allocationProposalId text [pk, not null]
  recommendationId text [not null]
  ownStockSnapshotId text [not null]
  allocationMethod text [not null, note: 'Версия метода пропорционального распределения.']
  proposedPurchaseUnits integer [not null, check: `"proposedPurchaseUnits" >= 0`]

  Note: 'Общие данные предложения. Позиции хранятся в AllocationLine; в API предложение содержит список lines. Исходное распределение сохраняется до правок менеджера.'
}

Table AllocationLine {
  allocationProposalId text [not null]
  listingId text [not null]
  proposedShipmentUnits integer [not null, check: `"proposedShipmentUnits" >= 0`]

  indexes {
    (allocationProposalId, listingId) [pk]
  }

  Note: 'Позиция распределения. Ключ — предложение и товар площадки. Одному предложению принадлежат несколько позиций; отдельного глобального идентификатора позиции не требуется.'
}

// Решение и планы

Table ManagerDecision {
  decisionId text [pk, not null]
  recommendationId text [not null, unique, note: 'Одна рекомендация получает не более одного итогового решения.']
  allocationProposalId text [null, unique, note: 'Обязательно при утверждении; может отсутствовать при раннем отказе.']
  ownStockSnapshotId text [null, note: 'Обязательно при утверждении; совпадает со снимком рассмотренного предложения.']
  status text [not null, note: 'approved или rejected.']
  decidedBy text [not null, note: 'Идентификатор менеджера, принявшего решение.']
  decidedAt timestamptz [not null]
  reason text [null, note: 'Причина изменения либо отказа; при отказе обязательна.']

  checks {
    `"status" IN ('approved', 'rejected')`
    `"status" <> 'approved' OR ("allocationProposalId" IS NOT NULL AND "ownStockSnapshotId" IS NOT NULL)`
    `"status" <> 'rejected' OR ("reason" IS NOT NULL AND length(btrim("reason")) > 0)`
  }

  Note: '''
    Решение менеджера. При утверждении фиксирует исходные версии и создаёт планы.
    При отказе планов нет; ссылки на предложение и свой остаток могут отсутствовать.
    Только для approved действует правило одного утверждения на снимок собственного остатка.
    Оно обеспечивается частичным уникальным индексом PostgreSQL, описанным в документе модели данных.
    Все связанные объекты относятся к одному селлеру и внутреннему товару.
  '''
}

Table ShipmentPlan {
  shipmentPlanId text [pk, not null]
  decisionId text [not null, unique]
  createdAt timestamptz [not null]

  Note: 'Заголовок плана отгрузки. Создаётся на основании утверждённого решения, если есть положительные количества. В API объединяется с ShipmentPlanLine в объект с lines.'
}

Table ShipmentPlanLine {
  shipmentPlanId text [not null]
  listingId text [not null]
  approvedShipmentUnits integer [not null, check: `"approvedShipmentUnits" > 0`]

  indexes {
    (shipmentPlanId, listingId) [pk]
  }

  Note: 'Позиция плана отгрузки. Ключ — план и товар площадки. Сумму отгрузок и доступный остаток проверяет сервер в транзакции утверждения.'
}

Table PurchasePlan {
  purchasePlanId text [pk, not null]
  decisionId text [not null, unique]
  createdAt timestamptz [not null]

  Note: 'Заголовок плана закупки. Создаётся на основании утверждённого решения при положительном объёме закупки. В текущем сценарии относится к одному внутреннему товару.'
}

Table PurchasePlanLine {
  purchasePlanId text [not null]
  productId text [not null]
  approvedPurchaseUnits integer [not null, check: `"approvedPurchaseUnits" > 0`]

  indexes {
    (purchasePlanId, productId) [pk]
  }

  Note: 'Позиция плана закупки. Ключ — план и внутренний товар. В API возвращается внутри PurchasePlan.lines; закупка не увеличивает запас текущей отгрузки.'
}

// Внешние ключи и кардинальности

Ref: MarketplaceAccount.sellerId > Seller.sellerId
Ref: Product.sellerId > Seller.sellerId
Ref: Listing.accountId > MarketplaceAccount.accountId
Ref: Listing.productId >? Product.productId
Ref: SyncRun.accountId > MarketplaceAccount.accountId
Ref: SalesSnapshot.syncRunId > SyncRun.syncRunId
Ref: SalesSnapshot.listingId > Listing.listingId
Ref: MarketplaceStockSnapshot.syncRunId > SyncRun.syncRunId
Ref: MarketplaceStockSnapshot.listingId > Listing.listingId
Ref: RuleVersion.sellerId > Seller.sellerId
Ref: Recommendation.productId > Product.productId
Ref: RecommendationLine.recommendationId > Recommendation.recommendationId
Ref: RecommendationLine.listingId > Listing.listingId
Ref: RecommendationLine.sourceSalesSnapshotId >? SalesSnapshot.salesSnapshotId
Ref: RecommendationLine.sourceStockSnapshotId >? MarketplaceStockSnapshot.stockSnapshotId
Ref: RecommendationLine.ruleVersionId >? RuleVersion.ruleVersionId
Ref: OwnStockSnapshot.productId > Product.productId
Ref: AllocationProposal.recommendationId > Recommendation.recommendationId
Ref: AllocationProposal.ownStockSnapshotId > OwnStockSnapshot.ownStockSnapshotId
Ref: Recommendation.recommendationId - ManagerDecision.recommendationId
Ref: AllocationProposal.allocationProposalId ?- ManagerDecision.allocationProposalId
Ref: ManagerDecision.ownStockSnapshotId >? OwnStockSnapshot.ownStockSnapshotId
Ref: ManagerDecision.decisionId - ShipmentPlan.decisionId
Ref: ManagerDecision.decisionId - PurchasePlan.decisionId
Ref: AllocationLine.allocationProposalId > AllocationProposal.allocationProposalId
Ref: AllocationLine.listingId > Listing.listingId
Ref: ShipmentPlanLine.shipmentPlanId > ShipmentPlan.shipmentPlanId
Ref: ShipmentPlanLine.listingId > Listing.listingId
Ref: PurchasePlanLine.purchasePlanId > PurchasePlan.purchasePlanId
Ref: PurchasePlanLine.productId > Product.productId

TableGroup seller_context [color: #E6EEF8, note: 'Селлер и товары'] {
  Seller
  MarketplaceAccount
  Product
  Listing
}

TableGroup input_data [color: #E5F2ED, note: 'Входные данные'] {
  SyncRun
  SalesSnapshot
  MarketplaceStockSnapshot
  OwnStockSnapshot
}

TableGroup calculation [color: #FFF2D9, note: 'Правила и рекомендация'] {
  RuleVersion
  Recommendation
  RecommendationLine
}

TableGroup allocation [color: #EEE8F6, note: 'Распределение'] {
  AllocationProposal
  AllocationLine
}

TableGroup decisions_plans [color: #E5F1F5, note: 'Решение и планы'] {
  ManagerDecision
  ShipmentPlan
  ShipmentPlanLine
  PurchasePlan
  PurchasePlanLine
}

DiagramView master_erd {
  Tables { * }
  TableGroups { * }
}

DiagramView sources_and_calculation {
  Tables {
    Seller
    MarketplaceAccount
    Product
    Listing
    SyncRun
    SalesSnapshot
    MarketplaceStockSnapshot
    RuleVersion
    Recommendation
    RecommendationLine
  }
}

DiagramView proposals_decisions_plans {
  Tables {
    Product
    Listing
    Recommendation
    OwnStockSnapshot
    AllocationProposal
    AllocationLine
    ManagerDecision
    ShipmentPlan
    ShipmentPlanLine
    PurchasePlan
    PurchasePlanLine
  }
}
