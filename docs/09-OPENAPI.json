{
  "openapi": "3.1.0",
  "info": {
    "title": "StockFlow — внутренний API основного сценария",
    "version": "1.0.0-case",
    "description": "Портфельная реконструкция внутреннего контракта StockFlow для сценария подсорта. Пути и примеры не являются выгрузкой из работающего сервера и не указывают на развёрнутый API. Доступ к данным селлера должен ограничиваться сервером; механизм аутентификации здесь не утверждается."
  },
  "tags": [
    {
      "name": "Синхронизация"
    },
    {
      "name": "Рекомендации"
    },
    {
      "name": "Собственный склад"
    },
    {
      "name": "Распределение"
    },
    {
      "name": "Решения"
    }
  ],
  "paths": {
    "/internal/v1/sellers/{sellerId}/marketplace-accounts/{accountId}/sync-state": {
      "parameters": [
        {
          "$ref": "#/components/parameters/sellerId"
        },
        {
          "$ref": "#/components/parameters/accountId"
        }
      ],
      "get": {
        "tags": [
          "Синхронизация"
        ],
        "operationId": "getAccountSyncState",
        "summary": "Получить состояние автоматического обновления кабинета",
        "responses": {
          "200": {
            "description": "Продажи и остатки показаны раздельно.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncState"
                }
              }
            }
          },
          "404": {
            "description": "Кабинет недоступен в области селлера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sellers/{sellerId}/products/{productId}/recommendations/latest": {
      "parameters": [
        {
          "$ref": "#/components/parameters/sellerId"
        },
        {
          "$ref": "#/components/parameters/productId"
        }
      ],
      "get": {
        "tags": [
          "Рекомендации"
        ],
        "operationId": "getLatestRecommendation",
        "summary": "Получить последнюю рекомендацию товара",
        "responses": {
          "200": {
            "description": "Последняя сохранённая рекомендация.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendation"
                },
                "example": {
                  "recommendationId": "rec-demo-01",
                  "productId": "SKU-DEMO-01",
                  "status": "ready",
                  "totalRecommendedUnits": 43,
                  "lines": [
                    {
                      "listingId": "ozon-demo",
                      "accountId": "ozon-account-demo",
                      "marketplace": "Ozon",
                      "dataState": "ready",
                      "salesUnits": 28,
                      "salesWindowDays": 28,
                      "marketplaceStockUnits": 12,
                      "targetCoverageDays": 21,
                      "recommendedUnits": 9,
                      "sourceSalesSnapshotId": "sales-ozon-demo",
                      "sourceStockSnapshotId": "stock-ozon-demo",
                      "ruleVersionId": "rule-ozon-demo",
                      "targetStockUnits": 21,
                      "roundingPolicy": "ceil",
                      "calculationIssue": null
                    },
                    {
                      "listingId": "wb-demo",
                      "accountId": "wb-account-demo",
                      "marketplace": "Wildberries",
                      "dataState": "ready",
                      "salesUnits": 56,
                      "salesWindowDays": 28,
                      "marketplaceStockUnits": 8,
                      "targetCoverageDays": 21,
                      "recommendedUnits": 34,
                      "sourceSalesSnapshotId": "sales-wb-demo",
                      "sourceStockSnapshotId": "stock-wb-demo",
                      "ruleVersionId": "rule-wb-demo",
                      "targetStockUnits": 42,
                      "roundingPolicy": "ceil",
                      "calculationIssue": null
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Для товара нет доступной рекомендации.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sellers/{sellerId}/products/{productId}/recommendations/{recommendationId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/sellerId"
        },
        {
          "$ref": "#/components/parameters/productId"
        },
        {
          "$ref": "#/components/parameters/recommendationId"
        }
      ],
      "get": {
        "tags": [
          "Рекомендации"
        ],
        "operationId": "getRecommendation",
        "summary": "Прочитать сохранённую рекомендацию и её входные версии",
        "responses": {
          "200": {
            "description": "Историческая рекомендация.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendation"
                },
                "example": {
                  "recommendationId": "rec-demo-01",
                  "productId": "SKU-DEMO-01",
                  "status": "ready",
                  "totalRecommendedUnits": 43,
                  "lines": [
                    {
                      "listingId": "ozon-demo",
                      "accountId": "ozon-account-demo",
                      "marketplace": "Ozon",
                      "dataState": "ready",
                      "salesUnits": 28,
                      "salesWindowDays": 28,
                      "marketplaceStockUnits": 12,
                      "targetCoverageDays": 21,
                      "recommendedUnits": 9,
                      "sourceSalesSnapshotId": "sales-ozon-demo",
                      "sourceStockSnapshotId": "stock-ozon-demo",
                      "ruleVersionId": "rule-ozon-demo",
                      "targetStockUnits": 21,
                      "roundingPolicy": "ceil",
                      "calculationIssue": null
                    },
                    {
                      "listingId": "wb-demo",
                      "accountId": "wb-account-demo",
                      "marketplace": "Wildberries",
                      "dataState": "ready",
                      "salesUnits": 56,
                      "salesWindowDays": 28,
                      "marketplaceStockUnits": 8,
                      "targetCoverageDays": 21,
                      "recommendedUnits": 34,
                      "sourceSalesSnapshotId": "sales-wb-demo",
                      "sourceStockSnapshotId": "stock-wb-demo",
                      "ruleVersionId": "rule-wb-demo",
                      "targetStockUnits": 42,
                      "roundingPolicy": "ceil",
                      "calculationIssue": null
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Рекомендация недоступна в области селлера и товара.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sellers/{sellerId}/products/{productId}/own-stock-snapshots": {
      "parameters": [
        {
          "$ref": "#/components/parameters/sellerId"
        },
        {
          "$ref": "#/components/parameters/productId"
        }
      ],
      "post": {
        "tags": [
          "Собственный склад"
        ],
        "operationId": "createOwnStockSnapshot",
        "summary": "Заново подтвердить остаток своего склада для утверждения",
        "description": "Менеджер подтверждает доступное количество перед каждым утверждением. Новый снимок не меняет прежние решения; фиксированного срока действия нет.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnStockInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Создан отдельный снимок, старые решения не изменены.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnStockSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Некорректная форма запроса.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Товар недоступен в области селлера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Количество либо источник не могут быть приняты.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sellers/{sellerId}/products/{productId}/allocation-proposals": {
      "parameters": [
        {
          "$ref": "#/components/parameters/sellerId"
        },
        {
          "$ref": "#/components/parameters/productId"
        }
      ],
      "post": {
        "tags": [
          "Распределение"
        ],
        "operationId": "createAllocationProposal",
        "summary": "Рассчитать предложение отгрузки и закупки",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AllocationProposalInput"
              },
              "example": {
                "recommendationId": "rec-demo-01",
                "ownStockSnapshotId": "own-stock-demo-01"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Сохранённое предложение на основе конкретных входных версий.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllocationProposal"
                },
                "example": {
                  "allocationProposalId": "alloc-demo-01",
                  "recommendationId": "rec-demo-01",
                  "ownStockSnapshotId": "own-stock-demo-01",
                  "allocationMethod": "proportional_largest_remainder_v1",
                  "availableUnits": 30,
                  "proposedPurchaseUnits": 13,
                  "lines": [
                    {
                      "listingId": "ozon-demo",
                      "proposedShipmentUnits": 6
                    },
                    {
                      "listingId": "wb-demo",
                      "proposedShipmentUnits": 24
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Некорректная форма запроса.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Товар, рекомендация либо снимок недоступны.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Входные версии не подходят для нового предложения.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Рекомендация неполная или остаток не подтверждён.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sellers/{sellerId}/products/{productId}/decisions": {
      "parameters": [
        {
          "$ref": "#/components/parameters/sellerId"
        },
        {
          "$ref": "#/components/parameters/productId"
        }
      ],
      "post": {
        "tags": [
          "Решения"
        ],
        "operationId": "createManagerDecision",
        "summary": "Утвердить количества либо отклонить рекомендацию",
        "description": "Утверждение создаёт отдельные планы с вложенными списками для положительных количеств; отклонение сохраняет решение без планов. Для каждого утверждения требуется новое подтверждение своего остатка: снимок, уже использованный в утверждённом решении, не принимается повторно. Повторное итоговое решение не создаёт второй план. Решение, заголовки планов и позиции сохраняются атомарно в одной транзакции PostgreSQL; ответ 201 возвращается после её завершения.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              },
              "example": {
                "recommendationId": "rec-demo-01",
                "allocationProposalId": "alloc-demo-01",
                "action": "approve",
                "shipmentLines": [
                  {
                    "listingId": "ozon-demo",
                    "units": 9
                  },
                  {
                    "listingId": "wb-demo",
                    "units": 21
                  }
                ],
                "purchaseUnits": 13
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Итоговое решение сохранено.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagerDecision"
                }
              }
            }
          },
          "400": {
            "description": "Некорректная форма запроса.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс недоступен в области селлера.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Рекомендация уже получила итоговое решение, снимок своего склада использован в другом утверждении или входное состояние изменилось.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Нет подтверждённого остатка, недостаточно данных или превышен доступный запас.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/sellers/{sellerId}/products/{productId}/decisions/{decisionId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/sellerId"
        },
        {
          "$ref": "#/components/parameters/productId"
        },
        {
          "$ref": "#/components/parameters/decisionId"
        }
      ],
      "get": {
        "tags": [
          "Решения"
        ],
        "operationId": "getManagerDecision",
        "summary": "Прочитать историческое решение и утверждённые планы",
        "responses": {
          "200": {
            "description": "Сохранённое решение.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagerDecision"
                }
              }
            }
          },
          "404": {
            "description": "Решение недоступно в области селлера и товара.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "sellerId": {
        "name": "sellerId",
        "in": "path",
        "required": true,
        "description": "Селлер, в пределах которого выполняется операция.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "accountId": {
        "name": "accountId",
        "in": "path",
        "required": true,
        "description": "Кабинет площадки.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "productId": {
        "name": "productId",
        "in": "path",
        "required": true,
        "description": "Внутренний товар селлера.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "recommendationId": {
        "name": "recommendationId",
        "in": "path",
        "required": true,
        "description": "Сохранённая рекомендация.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "decisionId": {
        "name": "decisionId",
        "in": "path",
        "required": true,
        "description": "Сохранённое решение.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "description": "Ошибка интерфейса.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Машинный код причины."
          },
          "message": {
            "type": "string",
            "description": "Сообщение для менеджера."
          }
        },
        "additionalProperties": false
      },
      "SyncResult": {
        "type": "object",
        "description": "Состояние синхронизации одного вида данных.",
        "required": [
          "sourceSystem",
          "status",
          "lastUpdatedAt",
          "errorCode"
        ],
        "properties": {
          "sourceSystem": {
            "type": "string",
            "description": "API подключённой площадки."
          },
          "status": {
            "type": "string",
            "description": "Результат обновления.",
            "enum": [
              "success",
              "error",
              "not_started"
            ]
          },
          "lastUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Время успешного обновления; null, если его не было."
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ],
            "description": "Код ошибки синхронизации, если она была."
          }
        },
        "additionalProperties": false
      },
      "SyncState": {
        "type": "object",
        "description": "Состояние автоматического получения продаж и остатков.",
        "required": [
          "sellerId",
          "accountId",
          "sales",
          "stock",
          "unmappedListingCount"
        ],
        "properties": {
          "sellerId": {
            "type": "string",
            "description": "Селлер."
          },
          "accountId": {
            "type": "string",
            "description": "Кабинет маркетплейса."
          },
          "sales": {
            "$ref": "#/components/schemas/SyncResult"
          },
          "stock": {
            "$ref": "#/components/schemas/SyncResult"
          },
          "unmappedListingCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Количество несопоставленных товаров площадки."
          }
        },
        "additionalProperties": false
      },
      "RecommendationItem": {
        "type": "object",
        "description": "Формат позиции RecommendationLine в массиве Recommendation.lines. В PostgreSQL позиция связана с рекомендацией и товаром площадки.",
        "required": [
          "listingId",
          "accountId",
          "marketplace",
          "dataState",
          "salesUnits",
          "salesWindowDays",
          "marketplaceStockUnits",
          "targetCoverageDays",
          "recommendedUnits",
          "sourceSalesSnapshotId",
          "sourceStockSnapshotId",
          "ruleVersionId",
          "targetStockUnits",
          "roundingPolicy",
          "calculationIssue"
        ],
        "properties": {
          "listingId": {
            "type": "string",
            "description": "Товар площадки."
          },
          "accountId": {
            "type": "string",
            "description": "Кабинет площадки."
          },
          "marketplace": {
            "type": "string",
            "description": "Название площадки."
          },
          "dataState": {
            "type": "string",
            "description": "Наличие снимков продаж и остатка; ready не гарантирует наличие версии правила.",
            "enum": [
              "ready",
              "missing_sales",
              "missing_stock",
              "missing_both"
            ]
          },
          "salesUnits": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Продажи за окно. Ноль при успешном обновлении отличается от null."
          },
          "salesWindowDays": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "Длина окна продаж."
          },
          "marketplaceStockUnits": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Подтверждённый остаток площадки или null."
          },
          "targetCoverageDays": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "Целевое покрытие из версии правила."
          },
          "recommendedUnits": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Расчётная потребность; null при недостатке данных."
          },
          "sourceSalesSnapshotId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Снимок продаж, использованный в расчёте."
          },
          "sourceStockSnapshotId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Снимок остатка площадки."
          },
          "ruleVersionId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Версия правила этой строки."
          },
          "targetStockUnits": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Целевой запас, приведённый к целым штукам по версии правила; null при невозможности его расчёта."
          },
          "roundingPolicy": {
            "type": [
              "string",
              "null"
            ],
            "description": "Правило округления целевого запаса из RuleVersion; null, если правило не определено."
          },
          "calculationIssue": {
            "type": [
              "string",
              "null"
            ],
            "description": "Причина невозможности расчёта; null при рассчитанном количестве."
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "dataState": {
                  "const": "ready"
                }
              },
              "required": [
                "dataState"
              ]
            },
            "then": {
              "properties": {
                "salesUnits": {
                  "type": "integer"
                },
                "salesWindowDays": {
                  "type": "integer"
                },
                "sourceSalesSnapshotId": {
                  "type": "string"
                },
                "marketplaceStockUnits": {
                  "type": "integer"
                },
                "sourceStockSnapshotId": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "dataState": {
                  "const": "missing_sales"
                }
              },
              "required": [
                "dataState"
              ]
            },
            "then": {
              "properties": {
                "salesUnits": {
                  "type": "null"
                },
                "salesWindowDays": {
                  "type": "null"
                },
                "sourceSalesSnapshotId": {
                  "type": "null"
                },
                "marketplaceStockUnits": {
                  "type": "integer"
                },
                "sourceStockSnapshotId": {
                  "type": "string"
                },
                "recommendedUnits": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "dataState": {
                  "const": "missing_stock"
                }
              },
              "required": [
                "dataState"
              ]
            },
            "then": {
              "properties": {
                "salesUnits": {
                  "type": "integer"
                },
                "salesWindowDays": {
                  "type": "integer"
                },
                "sourceSalesSnapshotId": {
                  "type": "string"
                },
                "marketplaceStockUnits": {
                  "type": "null"
                },
                "sourceStockSnapshotId": {
                  "type": "null"
                },
                "recommendedUnits": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "dataState": {
                  "const": "missing_both"
                }
              },
              "required": [
                "dataState"
              ]
            },
            "then": {
              "properties": {
                "salesUnits": {
                  "type": "null"
                },
                "salesWindowDays": {
                  "type": "null"
                },
                "sourceSalesSnapshotId": {
                  "type": "null"
                },
                "marketplaceStockUnits": {
                  "type": "null"
                },
                "sourceStockSnapshotId": {
                  "type": "null"
                },
                "recommendedUnits": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "recommendedUnits": {
                  "type": "integer"
                }
              },
              "required": [
                "recommendedUnits"
              ]
            },
            "then": {
              "properties": {
                "dataState": {
                  "const": "ready"
                },
                "targetStockUnits": {
                  "type": "integer"
                },
                "targetCoverageDays": {
                  "type": "integer"
                },
                "roundingPolicy": {
                  "type": "string",
                  "minLength": 1
                },
                "ruleVersionId": {
                  "type": "string",
                  "minLength": 1
                },
                "calculationIssue": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "calculationIssue": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      },
      "Recommendation": {
        "type": "object",
        "description": "Исходная потребность площадок до ограничения своим складом. Список lines является частью рекомендации.",
        "required": [
          "recommendationId",
          "productId",
          "status",
          "totalRecommendedUnits",
          "lines"
        ],
        "properties": {
          "recommendationId": {
            "type": "string",
            "description": "Идентификатор сохранённой рекомендации."
          },
          "productId": {
            "type": "string",
            "description": "Внутренний товар селлера."
          },
          "status": {
            "type": "string",
            "description": "Готовность рекомендации.",
            "enum": [
              "ready",
              "incomplete"
            ]
          },
          "totalRecommendedUnits": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Сумма всех строк; null, если хотя бы одна строка не рассчитана."
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "totalRecommendedUnits": {
                  "type": "integer"
                },
                "lines": {
                  "items": {
                    "properties": {
                      "recommendedUnits": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "totalRecommendedUnits": {
                  "type": "null"
                },
                "lines": {
                  "contains": {
                    "properties": {
                      "recommendedUnits": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "recommendedUnits"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "OwnStockInput": {
        "type": "object",
        "description": "Новое подтверждение доступного остатка менеджером перед утверждением плана. Фиксированного срока действия нет.",
        "required": [
          "availableUnits",
          "sourceKind",
          "sourceLabel",
          "sourceObservedAt"
        ],
        "properties": {
          "availableUnits": {
            "type": "integer",
            "minimum": 0,
            "description": "Доступное к распределению количество собственного склада."
          },
          "sourceKind": {
            "type": "string",
            "description": "Вид учёта селлера.",
            "enum": [
              "accounting_system",
              "seller_table"
            ]
          },
          "sourceLabel": {
            "type": "string",
            "description": "Понятное менеджеру обозначение источника."
          },
          "sourceObservedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время исходного остатка в учёте селлера."
          }
        },
        "additionalProperties": false
      },
      "OwnStockSnapshot": {
        "type": "object",
        "description": "Подтверждённый снимок своего склада.",
        "required": [
          "ownStockSnapshotId",
          "productId",
          "availableUnits",
          "sourceKind",
          "sourceLabel",
          "sourceObservedAt",
          "confirmedAt",
          "confirmedBy"
        ],
        "properties": {
          "ownStockSnapshotId": {
            "type": "string",
            "description": "Идентификатор неизменяемого снимка."
          },
          "productId": {
            "type": "string",
            "description": "Внутренний товар."
          },
          "availableUnits": {
            "type": "integer",
            "minimum": 0,
            "description": "Принятое количество."
          },
          "sourceKind": {
            "type": "string",
            "description": "Вид источника.",
            "enum": [
              "accounting_system",
              "seller_table"
            ]
          },
          "sourceLabel": {
            "type": "string",
            "description": "Обозначение источника."
          },
          "sourceObservedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время исходного остатка."
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время нового подтверждения остатка в StockFlow."
          },
          "confirmedBy": {
            "type": "string",
            "description": "Менеджер, подтвердивший значение; определяется сервером."
          }
        },
        "additionalProperties": false
      },
      "AllocationProposalInput": {
        "type": "object",
        "description": "Запрос предложения распределения.",
        "required": [
          "recommendationId",
          "ownStockSnapshotId"
        ],
        "properties": {
          "recommendationId": {
            "type": "string",
            "description": "Рекомендация, потребность которой распределяется."
          },
          "ownStockSnapshotId": {
            "type": "string",
            "description": "Подтверждённый снимок собственного склада."
          }
        },
        "additionalProperties": false
      },
      "AllocationItem": {
        "type": "object",
        "description": "Формат позиции AllocationLine в массиве AllocationProposal.lines. В PostgreSQL позиция связана с предложением и товаром площадки.",
        "required": [
          "listingId",
          "proposedShipmentUnits"
        ],
        "properties": {
          "listingId": {
            "type": "string",
            "description": "Товар площадки."
          },
          "proposedShipmentUnits": {
            "type": "integer",
            "minimum": 0,
            "description": "Предложенное количество из своего склада."
          }
        },
        "additionalProperties": false
      },
      "AllocationProposal": {
        "type": "object",
        "description": "Начальное пропорциональное распределение до решения менеджера. При дефиците целые штуки назначаются методом наибольших дробных остатков. Список lines является частью предложения.",
        "required": [
          "allocationProposalId",
          "recommendationId",
          "ownStockSnapshotId",
          "allocationMethod",
          "availableUnits",
          "proposedPurchaseUnits",
          "lines"
        ],
        "properties": {
          "allocationProposalId": {
            "type": "string",
            "description": "Идентификатор сохранённого предложения."
          },
          "recommendationId": {
            "type": "string",
            "description": "Исходная рекомендация."
          },
          "ownStockSnapshotId": {
            "type": "string",
            "description": "Принятый остаток своего склада."
          },
          "allocationMethod": {
            "type": "string",
            "enum": [
              "proportional_largest_remainder_v1"
            ],
            "description": "Версия метода расчёта начального предложения."
          },
          "availableUnits": {
            "type": "integer",
            "minimum": 0,
            "description": "Доступное к распределению количество."
          },
          "proposedPurchaseUnits": {
            "type": "integer",
            "minimum": 0,
            "description": "Недостающее количество для отдельной закупки."
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/AllocationItem"
            }
          }
        },
        "additionalProperties": false
      },
      "ShipmentApprovalItem": {
        "type": "object",
        "description": "Элемент списка shipmentLines в запросе утверждения. Нулевое количество не включается в сохранённый план.",
        "required": [
          "listingId",
          "units"
        ],
        "properties": {
          "listingId": {
            "type": "string",
            "description": "Товар площадки."
          },
          "units": {
            "type": "integer",
            "minimum": 0,
            "description": "Утверждаемое количество для текущей отгрузки."
          }
        },
        "additionalProperties": false
      },
      "ApproveDecisionRequest": {
        "type": "object",
        "description": "Утверждение менеджера.",
        "required": [
          "recommendationId",
          "allocationProposalId",
          "action",
          "shipmentLines",
          "purchaseUnits"
        ],
        "properties": {
          "recommendationId": {
            "type": "string",
            "description": "Исходная рекомендация."
          },
          "allocationProposalId": {
            "type": "string",
            "description": "Рассмотренное предложение распределения."
          },
          "action": {
            "const": "approve",
            "description": "Утвердить исходные либо изменённые количества."
          },
          "shipmentLines": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/components/schemas/ShipmentApprovalItem"
            },
            "description": "Допускается пустой список для одной закупки. listingId не повторяется; сервер проверяет принадлежность рекомендации и сумму отгрузки."
          },
          "purchaseUnits": {
            "type": "integer",
            "minimum": 0,
            "description": "Отдельно утверждаемое количество к закупке."
          },
          "reason": {
            "type": "string",
            "description": "Причина изменения предложения; при необходимости."
          }
        },
        "additionalProperties": false
      },
      "RejectDecisionRequest": {
        "type": "object",
        "description": "Отклонение менеджера.",
        "required": [
          "recommendationId",
          "action",
          "reason"
        ],
        "properties": {
          "recommendationId": {
            "type": "string",
            "description": "Отклоняемая рекомендация."
          },
          "action": {
            "const": "reject",
            "description": "Отклонить без создания планов."
          },
          "reason": {
            "type": "string",
            "description": "Почему менеджер не принимает рекомендацию.",
            "pattern": "\\S"
          },
          "allocationProposalId": {
            "type": "string",
            "minLength": 1,
            "description": "Рассмотренное предложение; передаётся при отказе после его просмотра. Для раннего отказа не требуется."
          }
        },
        "additionalProperties": false
      },
      "DecisionRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ApproveDecisionRequest"
          },
          {
            "$ref": "#/components/schemas/RejectDecisionRequest"
          }
        ],
        "description": "Утверждение либо отклонение. Сервер проверяет принадлежность ресурсов одному селлеру и товару."
      },
      "ManagerDecision": {
        "type": "object",
        "description": "Историческое решение с отдельными объектами планов отгрузки и закупки. Нулевой объём не создаёт соответствующий план. При утверждении обоих нулевых объёмов сохраняется решение без планов.",
        "required": [
          "decisionId",
          "recommendationId",
          "allocationProposalId",
          "ownStockSnapshotId",
          "status",
          "decidedBy",
          "decidedAt",
          "shipmentPlan",
          "purchasePlan",
          "reason"
        ],
        "properties": {
          "decisionId": {
            "type": "string",
            "description": "Сохранённое итоговое решение."
          },
          "recommendationId": {
            "type": "string",
            "description": "Исходная рекомендация."
          },
          "allocationProposalId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Рассмотренное предложение; null при раннем отклонении."
          },
          "ownStockSnapshotId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Снимок рассмотренного предложения; null при раннем отклонении. При утверждении должен быть не использован прежним утверждением."
          },
          "status": {
            "type": "string",
            "description": "Итог.",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "decidedBy": {
            "type": "string",
            "description": "Менеджер, принявший решение; определяется сервером."
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время решения."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Причина изменения или отклонения."
          },
          "shipmentPlan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ShipmentPlan"
              },
              {
                "type": "null"
              }
            ],
            "description": "План отгрузки; null при отказе или отсутствии положительных количеств отгрузки."
          },
          "purchasePlan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PurchasePlan"
              },
              {
                "type": "null"
              }
            ],
            "description": "План закупки; null при отказе или нулевом количестве закупки."
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "approved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "allocationProposalId": {
                  "type": "string"
                },
                "ownStockSnapshotId": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "shipmentPlan": {
                  "type": "null"
                },
                "purchasePlan": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      },
      "ShipmentPlanItem": {
        "type": "object",
        "description": "Формат позиции ShipmentPlanLine в массиве ShipmentPlan.lines. Ключ в БД — план и товар площадки; родительский идентификатор не повторяется во вложенном ответе.",
        "required": [
          "listingId",
          "approvedShipmentUnits"
        ],
        "properties": {
          "listingId": {
            "type": "string",
            "description": "Товар площадки."
          },
          "approvedShipmentUnits": {
            "type": "integer",
            "minimum": 1,
            "description": "Утверждённое количество к отгрузке."
          }
        },
        "additionalProperties": false
      },
      "PurchasePlanItem": {
        "type": "object",
        "description": "Формат позиции PurchasePlanLine в массиве PurchasePlan.lines. Ключ в БД — план и внутренний товар; родительский идентификатор не повторяется во вложенном ответе.",
        "required": [
          "productId",
          "approvedPurchaseUnits"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "description": "Внутренний товар."
          },
          "approvedPurchaseUnits": {
            "type": "integer",
            "minimum": 1,
            "description": "Утверждённое количество к закупке."
          }
        },
        "additionalProperties": false
      },
      "ShipmentPlan": {
        "type": "object",
        "description": "План отгрузки на основании утверждённого решения по одному внутреннему товару. Фактическую отправку не подтверждает. Список lines является частью плана.",
        "required": [
          "shipmentPlanId",
          "decisionId",
          "createdAt",
          "lines"
        ],
        "properties": {
          "shipmentPlanId": {
            "type": "string",
            "description": "Идентификатор плана отгрузки."
          },
          "decisionId": {
            "type": "string",
            "description": "Утверждённое решение-основание."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время создания плана."
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ShipmentPlanItem"
            },
            "description": "Положительные количества по товарам площадок; один товар площадки не повторяется."
          }
        },
        "additionalProperties": false
      },
      "PurchasePlan": {
        "type": "object",
        "description": "План закупки на основании утверждённого решения. В текущем сценарии содержит строку одного внутреннего товара; заказ поставщику выполняется вне StockFlow. Список lines является частью плана.",
        "required": [
          "purchasePlanId",
          "decisionId",
          "createdAt",
          "lines"
        ],
        "properties": {
          "purchasePlanId": {
            "type": "string",
            "description": "Идентификатор плана закупки."
          },
          "decisionId": {
            "type": "string",
            "description": "Утверждённое решение-основание."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время создания плана."
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/PurchasePlanItem"
            },
            "description": "Строка закупки внутреннего товара, по которому принято решение."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
